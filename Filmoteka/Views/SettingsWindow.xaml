<Window x:Class="Filmoteka.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource CinemaWindow}">

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="Настройки" FontSize="25" FontWeight="Bold" Margin="0,0,0,18" />

        <!-- TMDB -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel>
                <TextBlock Text="TMDB (постери и данни за филми)" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" LineHeight="20">
                    <Run Text="1. Регистрирайте се безплатно в" />
                    <Hyperlink NavigateUri="https://www.themoviedb.org/signup" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AccentBrush}">themoviedb.org</Hyperlink>
                    <LineBreak />
                    <Run Text="2. Отворете" />
                    <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AccentBrush}">Settings → API</Hyperlink>
                    <Run Text="и заявете ключ." />
                    <LineBreak />
                    <Run Text="3. Копирайте „API Key“ или „API Read Access Token“ и го поставете тук." />
                </TextBlock>

                <TextBlock Text="API КЛЮЧ" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiKeyBox" Tag="Поставете ключа тук…" />
                    <Button x:Name="TestButton" Grid.Column="1" Content="Провери" Margin="8,0,0,0" Click="Test_Click" />
                </Grid>
                <TextBlock x:Name="TestResult" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0" />
            </StackPanel>
        </Border>

        <!-- База данни -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="База данни (SQLite)" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DbPathBox" IsReadOnly="True" FontSize="12" />
                    <Button Grid.Column="1" Content="Отвори папката" Margin="8,0,0,0" Click="OpenDbFolder_Click" />
                </Grid>
                <TextBlock Text="Постерите се пазят локално след първото изтегляне, така че се виждат и без интернет."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,10,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отказ" IsCancel="True" MinWidth="110" Margin="0,0,10,0" />
            <Button Content="Запази" Style="{StaticResource AccentButton}" MinWidth="130" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
