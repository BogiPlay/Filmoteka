<Window x:Class="Filmoteka.Views.GenresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Жанрове"
        Width="640" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource CinemaWindow}">

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Жанрове" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="Жанровете се избират във формата за филм. Жанр, който се използва, не може да бъде изтрит."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="1" CornerRadius="14" Padding="6">
            <DataGrid x:Name="GenresGrid" SelectionChanged="GenresGrid_SelectionChanged" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ЖАНР" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="БРОЙ ФИЛМИ" Binding="{Binding MovieCount}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" MaxLength="50" Tag="Име на жанр…" />
            <Button Grid.Column="1" Content="Добави" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Add_Click" />
            <Button Grid.Column="2" Content="Преименувай" Margin="8,0,0,0" Click="Rename_Click" />
            <Button Grid.Column="3" Content="Изтрий" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click" />
        </Grid>

        <TextBlock x:Name="MessageText" Grid.Row="3" Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap" />

        <Button Grid.Row="4" Content="Затвори" IsCancel="True" HorizontalAlignment="Right" MinWidth="110"
                Margin="0,14,0,0" />
    </Grid>
</Window>
